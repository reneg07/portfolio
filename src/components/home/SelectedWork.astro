---
import Container from '../layout/Container.astro';
import FeaturedProject from '../projects/FeaturedProject.astro';
import ProjectCard from '../projects/ProjectCard.astro';
import { featuredProject, secondaryProjects } from '../../data/projects';
---

<section class="w-full bg-[#F6F4F1] border-b border-[#E6E2DD] scroll-mt-16" id="work">
  <Container class="py-16 sm:py-20 md:py-24">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 pb-4 border-b border-[#E6E2DD] gap-4">
      <div>
        <span class="label-index text-[#A48F7A] block mb-2">01 / PROYECTOS SELECCIONADOS</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-[#171717] tracking-tight">
          Sistemas &amp; Plataformas
        </h2>
      </div>
      <p class="text-sm sm:text-base text-[#686662] max-w-md">
        Una selección de proyectos y plataformas en los que he participado o desarrollado de forma integral.
      </p>
    </div>

    <!-- Projects List -->
    <div class="space-y-8 sm:space-y-12">
      <!-- 01: Featured Project (FORMA) -->
      <FeaturedProject project={featuredProject} />

      <!-- 02-04: Secondary Projects Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 lg:gap-10">
        {secondaryProjects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>
    </div>
  </Container>
</section>

---
import Container from '../layout/Container.astro';

const contactLinks = [
  {
    label: 'Correo',
    value: 'renealfaro753@gmail.com',
    href: 'mailto:renealfaro753@gmail.com',
    isExternal: false
  },
  {
    label: 'GitHub',
    value: 'github.com/reneg07',
    href: 'https://github.com/reneg07',
    isExternal: true
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/rene-guevara',
    href: 'https://www.linkedin.com/in/rene-guevara-519775299/',
    isExternal: true
  },
  {
    label: 'Sitio Web',
    value: 'keeycode.com',
    href: 'https://keeycode.com',
    isExternal: true
  }
];
---

<section class="w-full bg-white scroll-mt-16" id="contact">
  <Container class="py-16 sm:py-20 md:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16">
      <!-- Left Column: Title & Action -->
      <div class="lg:col-span-6 space-y-6">
        <div>
          <span class="label-index text-[#A48F7A] block mb-2">06 / CONTACTO</span>
          <h2 class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-tight text-[#171717] leading-[1.05]">
            Conectemos.
          </h2>
        </div>

        <p class="text-base sm:text-lg text-[#686662] max-w-md leading-relaxed">
          Puedes encontrarme en mis plataformas profesionales o contactarme directamente por correo.
        </p>

        <div class="pt-2">
          <a
            href="mailto:renealfaro753@gmail.com"
            class="group inline-flex items-center gap-2 px-6 py-3.5 bg-[#171717] text-white hover:bg-[#A48F7A] transition-colors duration-200 label-caps text-xs tracking-wider focus-visible:ring-1 focus-visible:ring-[#171717]"
            aria-label="Enviar un correo electrónico a René Guevara"
          >
            <span>Enviar correo</span>
            <span class="text-xs transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- Right Column: Direct Links List -->
      <div class="lg:col-span-6 flex flex-col justify-center pt-6 lg:pt-0">
        <div class="border-t border-[#E6E2DD] divide-y divide-[#E6E2DD]">
          {contactLinks.map((item) => (
            <a
              href={item.href}
              target={item.isExternal ? '_blank' : undefined}
              rel={item.isExternal ? 'noopener noreferrer' : undefined}
              class="py-4 sm:py-5 flex items-center justify-between group hover:bg-[#F6F4F1] px-3 sm:px-4 transition-colors duration-150 focus-visible:ring-1 focus-visible:ring-[#171717]"
              aria-label={`${item.label}: ${item.value}${item.isExternal ? ' (abre en nueva ventana)' : ''}`}
            >
              <div>
                <span class="label-index text-[#A48F7A] block text-[11px] mb-0.5">
                  {item.label}
                </span>
                <span class="text-sm sm:text-base font-medium text-[#171717]">
                  {item.value}
                </span>
              </div>

              <span
                class="label-caps text-xs text-[#686662] group-hover:text-[#171717] transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 select-none"
                aria-hidden="true"
              >
                ↗
              </span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>

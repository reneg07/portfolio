---
import Container from '../layout/Container.astro';
import { experiences } from '../../data/experience';
---

<section class="w-full bg-[#F6F4F1] border-b border-[#E6E2DD] scroll-mt-16" id="experience">
  <Container class="py-16 sm:py-20 md:py-24">
    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16 pb-4 border-b border-[#E6E2DD] gap-4">
      <div>
        <span class="label-index text-[#A48F7A] block mb-2">03 / EXPERIENCIA</span>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-semibold text-[#171717] tracking-tight">
          Experiencia
        </h2>
      </div>
      <p class="text-sm sm:text-base text-[#686662] max-w-md">
        Trayectoria profesional en desarrollo de software, mantenimiento de sistemas y emprendimiento tecnológico.
      </p>
    </div>

    <!-- Editorial Ledger Rows -->
    <div class="divide-y divide-[#E6E2DD] border-t border-b border-[#E6E2DD]">
      {experiences.map((item) => (
        <div class="py-6 sm:py-8 grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-6 items-start hover:bg-[#F1EDE8]/50 transition-colors duration-200 px-2 sm:px-4">
          <!-- Column 1: Period -->
          <div class="md:col-span-3">
            <span class="label-caps text-xs text-[#A48F7A] font-semibold tracking-wider">
              {item.period}
            </span>
          </div>

          <!-- Column 2: Role & Organization -->
          <div class="md:col-span-4">
            <h3 class="text-base sm:text-lg text-[#171717] font-semibold">
              {item.role}
            </h3>
            <span class="label-caps text-xs text-[#686662] block mt-0.5">
              {item.organization}
            </span>
          </div>

          <!-- Column 3: Description -->
          <div class="md:col-span-5">
            <p class="text-xs sm:text-sm text-[#686662] leading-relaxed">
              {item.description}
            </p>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>

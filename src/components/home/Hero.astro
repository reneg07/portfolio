---
import Container from '../layout/Container.astro';
import { getSectionLink } from '../../utils/paths';

export interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<section class="w-full bg-white border-b border-[#E6E2DD] flex flex-col justify-between" id="hero">
  <Container class="pt-6 sm:pt-8 md:pt-12 pb-8 sm:pb-12 md:pb-16 flex-1 flex flex-col justify-between">
    <!-- Top Metadata -->
    <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs text-[#686662] pb-4 sm:pb-6 border-b border-[#E6E2DD] hero-meta">
      <span>San Salvador, El Salvador</span>
      <span class="text-[#E6E2DD] select-none" aria-hidden="true">·</span>
      <span>Español nativo · Inglés intermedio</span>
    </div>

    <!-- Center Typography & Statements -->
    <div class="py-8 sm:py-12 md:py-16 max-w-5xl">
      <div class="space-y-3 sm:space-y-4">
        <span class="label-caps text-xs tracking-widest text-[#A48F7A] block hero-role">
          Desarrollador de Software Full-Stack · Co-Fundador en KeeyCode
        </span>
        <h1 class="font-display-hero text-[#171717] uppercase tracking-tight leading-[0.92] hero-title">
          René<br />Guevara<span class="text-[#A48F7A] font-light">.</span>
        </h1>
      </div>

      <div class="pt-6 sm:pt-8 space-y-3 max-w-2xl hero-statements">
        <p class="text-xl sm:text-2xl md:text-3xl text-[#171717] font-medium tracking-tight leading-snug">
          “Construyo productos digitales y soluciones de software con propósito.”
        </p>
        <p class="text-sm sm:text-base md:text-lg text-[#686662] font-normal leading-relaxed">
          Desarrollo soluciones web y sistemas digitales combinando lógica, diseño y tecnología para resolver necesidades reales.
        </p>
      </div>
    </div>

    <!-- Bottom Action Anchor -->
    <div class="pt-4 flex items-center justify-between border-t border-[#E6E2DD]">
      <a
        href={getSectionLink('work', currentPath)}
        class="group inline-flex items-center gap-2 text-xs label-caps text-[#171717] hover:text-[#A48F7A] transition-colors py-2 focus-visible:ring-1 focus-visible:ring-[#171717]"
        aria-label="Ir a la sección de proyectos seleccionados"
      >
        <span>Proyectos Seleccionados</span>
        <span class="text-sm transition-transform duration-200 group-hover:translate-y-1" aria-hidden="true">↓</span>
      </a>
    </div>
  </Container>
</section>

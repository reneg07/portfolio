---
import Container from './Container.astro';
import { getSectionLink, resolvePath } from '../../utils/paths';

export interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { label: 'Work', id: 'work' },
  { label: 'About', id: 'about' },
  { label: 'Experience', id: 'experience' },
  { label: 'Stack', id: 'stack' },
  { label: 'Contact', id: 'contact' },
];

const homeLink = resolvePath('/');
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 backdrop-blur-md border-b border-[#E6E2DD] transition-all">
  <Container class="h-16 flex items-center justify-between">
    <!-- Brand / Logo -->
    <a
      href={homeLink}
      class="flex items-center gap-1 py-2 group focus-visible:ring-1 focus-visible:ring-[#171717]"
      aria-label="René Guevara — Inicio"
    >
      <span class="text-xl font-semibold tracking-tight text-[#171717]">RG</span>
      <span class="label-index text-[#A48F7A] font-bold select-none">/</span>
    </a>

    <!-- Desktop Navigation -->
    <div class="hidden md:flex items-center gap-8">
      <nav class="flex items-center gap-8" aria-label="Navegación principal">
        {navItems.map((item) => (
          <a
            href={getSectionLink(item.id, currentPath)}
            class="label-caps text-[#686662] hover:text-[#171717] transition-colors py-1 focus-visible:ring-1 focus-visible:ring-[#171717]"
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="h-4 w-[1px] bg-[#E6E2DD]" aria-hidden="true"></div>

      <a
        href="https://www.keeycode.com"
        target="_blank"
        rel="noopener noreferrer"
        class="group label-caps text-[#686662] hover:text-[#171717] flex items-center gap-1 transition-colors py-1 focus-visible:ring-1 focus-visible:ring-[#171717]"
        aria-label="KeeyCode (sitio externo, abre en nueva ventana)"
      >
        <span>KeeyCode</span>
        <span class="text-[11px] leading-none select-none transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden p-2 text-[#171717] hover:text-[#A48F7A] focus-visible:ring-1 focus-visible:ring-[#171717] transition-colors"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú de navegación"
    >
      <svg id="menu-icon-open" class="w-6 h-6 block" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="square" stroke-linejoin="miter" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="square" stroke-linejoin="miter" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </Container>

  <!-- Mobile Dropdown Menu -->
  <div
    id="mobile-menu"
    class="hidden md:hidden bg-white border-b border-[#E6E2DD] px-5 sm:px-8 py-6 space-y-4 shadow-none"
    aria-label="Menú móvil"
  >
    <nav class="flex flex-col space-y-3">
      {navItems.map((item) => (
        <a
          href={getSectionLink(item.id, currentPath)}
          class="mobile-nav-link label-caps text-sm text-[#686662] hover:text-[#171717] py-2 border-b border-[#F1F1EF] transition-colors"
        >
          {item.label}
        </a>
      ))}
      <a
        href="https://www.keeycode.com"
        target="_blank"
        rel="noopener noreferrer"
        class="mobile-nav-link label-caps text-sm text-[#171717] flex items-center justify-between py-2 pt-3"
      >
        <span>KeeyCode</span>
        <span class="text-xs" aria-hidden="true">↗</span>
      </a>
    </nav>
  </div>
</header>

<script>
  function setupMobileMenu() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');
    const navLinks = document.querySelectorAll('.mobile-nav-link');

    if (!toggleBtn || !menu || !iconOpen || !iconClose) return;

    const btn = toggleBtn;
    const navMenu = menu;
    const openIcon = iconOpen;
    const closeIcon = iconClose;

    function open() {
      btn.setAttribute('aria-expanded', 'true');
      btn.setAttribute('aria-label', 'Cerrar menú de navegación');
      navMenu.classList.remove('hidden');
      openIcon.classList.add('hidden');
      closeIcon.classList.remove('hidden');
    }

    function close() {
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Abrir menú de navegación');
      navMenu.classList.add('hidden');
      openIcon.classList.remove('hidden');
      closeIcon.classList.add('hidden');
    }

    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      if (isExpanded) {
        close();
      } else {
        open();
      }
    });

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        close();
      });
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btn.getAttribute('aria-expanded') === 'true') {
        close();
        btn.focus();
      }
    });
  }

  // Setup on initial load and handle Astro lifecycle
  setupMobileMenu();
  document.addEventListener('astro:page-load', setupMobileMenu);
</script>

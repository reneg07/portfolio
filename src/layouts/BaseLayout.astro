---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEO from '../components/ui/SEO.astro';
import { resolvePath } from '../utils/paths';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={resolvePath('/favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <SEO title={title} description={description} ogImage={ogImage} />
  </head>
  <body class="bg-white text-[#171717] antialiased selection:bg-[#E6E2DD] selection:text-[#171717] flex flex-col min-h-screen">
    <!-- Skip to main content link for accessibility -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-[#171717] focus:text-white focus:px-4 focus:py-2 focus:text-xs focus:font-medium focus:outline-none"
    >
      Saltar al contenido principal
    </a>

    <Header currentPath={currentPath} />

    <main id="main-content" class="w-full pt-16 flex-1 flex flex-col">
      <slot />
    </main>

    <Footer currentPath={currentPath} />

    <!-- Motion animations progressive enhancement -->
    <script>
      import '../scripts/animations';
    </script>
  </body>
</html>
